# ---------------------------------------------------------------
# VitalQR server configuration
# Copy this file to `.env` and adjust. `.env` is gitignored.
# ---------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Public origin of the CLIENT app. This is what gets encoded into the
# QR code, so it must be reachable by the phone doing the scanning.
# For a live demo on real phones this has to be an HTTPS URL
# (Vercel / Firebase Hosting), not localhost.
PUBLIC_APP_URL=http://localhost:5173

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Data store -------------------------------------------------
# memory    = JSON file at server/.data/db.json. Zero setup, works offline.
# firestore = Firebase Firestore via the Admin SDK (needs creds below).
DATA_STORE=memory

# --- Auth -------------------------------------------------------
# local    = this server issues its own JWTs (zero setup).
# firebase = this server verifies Firebase Auth ID tokens.
AUTH_MODE=local

# Only used when AUTH_MODE=local. Change this to any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Firebase (only needed when DATA_STORE or AUTH_MODE = firebase) ---
# Easiest: download the service account JSON from
# Firebase Console > Project settings > Service accounts > Generate new private key
# and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=

# --- OTP --------------------------------------------------------
# console = print the OTP to the server terminal (demo/dev, no cost)
# twilio  = send a real SMS via Twilio
OTP_TRANSPORT=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
