# Leave empty in development: vite.config.js proxies /api to localhost:5000.
# In production set this to the deployed API origin, e.g. https://vitalqr-api.onrender.com
VITE_API_URL=

# local    = sign in against our own Express API (matches server AUTH_MODE=local)
# firebase = sign in with the Firebase Auth SDK (matches server AUTH_MODE=firebase)
VITE_AUTH_MODE=local

# Only needed when VITE_AUTH_MODE=firebase.
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
